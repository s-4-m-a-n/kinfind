# Copy this file to .env and fill in your own values. .env is git-ignored.
# Real environment variables take precedence over values in .env.

# OpenRouter key for AI photo matching: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# First admin account, created on start-up only while there are no accounts yet
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Number of reverse proxies in front of the app, so rate limits see real visitor addresses (Cloud Run: 1)
# TRUSTED_PROXY_HOPS=0

# How often to check GDACS for new disasters, in minutes (0 turns it off)
# GDACS_SYNC_MINUTES=60

# Model for colour illustrations of photos of the deceased
# AI_ILLUSTRATION_MODEL=google/gemini-3.1-flash-image
