# Copy this file to .env and fill in your own values. .env is git-ignored.
# Real environment variables take precedence over values in .env.

# AI (photo check and illustrations) runs on Gemini. Choose one:
# - Vertex AI in a Google Cloud project (billed to that project; on Cloud Run the service account
#   needs roles/aiplatform.user, locally run `gcloud auth application-default login`):
# VERTEX_PROJECT=
# VERTEX_LOCATION=global
# - or OpenRouter: https://openrouter.ai/settings/keys
# OPENROUTER_API_KEY=

# OAuth web client ID for "Continue with Google" (Google Cloud console > Google Auth Platform > Clients).
# Add this site's address (e.g. http://localhost:8765) to the client's Authorized JavaScript origins.
# Leave empty to hide the Google button.
# GOOGLE_CLIENT_ID=

# Google Maps tiles for the zone maps (Map Tiles API). Create a browser key restricted to
# tile.googleapis.com and this site's address (e.g. http://localhost:8765/*). Without it the maps
# use OpenStreetMap.
# MAPS_API_KEY=

# First admin account, created on start-up only while there are no accounts yet
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Number of reverse proxies in front of the app, so rate limits see real visitor addresses (Cloud Run: 1)
# TRUSTED_PROXY_HOPS=0

# How often to check GDACS for new disasters, in minutes (0 turns it off)
# GDACS_SYNC_MINUTES=60

# Model for colour illustrations of photos of the deceased
# AI_ILLUSTRATION_MODEL=google/gemini-3.1-flash-image
